<?xml version="1.0" encoding="utf-8"?>
<!--
    T-018: cookies.txt is excluded from both cloud backup and device-to-device
    transfer on API 31+. The pre-31 path uses backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
    </device-transfer>
</data-extraction-rules>
